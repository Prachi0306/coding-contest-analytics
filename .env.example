# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=5000

# ================================
# MongoDB Configuration
# ================================
MONGODB_URI=mongodb://localhost:27017/coding-contest-analytics

# ================================
# JWT Configuration
# ================================
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:6379

# ================================
# External APIs
# ================================
CODEFORCES_API_BASE=https://codeforces.com/api

# ================================
# CORS Configuration
# ================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# Frontend URL (for production)
# ================================
# Set this to your deployed frontend URL in production
# CLIENT_URL=https://your-frontend-domain.com

# ================================
# Logging
# ================================
LOG_LEVEL=debug

# ================================
# Email Configuration (SMTP)
# ================================
# Required for user registration and verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ganesha1friend@gmail.com
EMAIL_FROM=ganesha1friend@gmail.com
SMTP_PASS=snmafxegqnxxxnzt
FRONTEND_URL=http://localhost:5173