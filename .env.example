# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=5000

# ================================
# MongoDB Configuration
# ================================
MONGODB_URI=mongodb://localhost:27017/coding-contest-analytics

# ================================
# JWT Configuration
# ================================
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:6379

# ================================
# External APIs
# ================================
CODEFORCES_API_BASE=https://codeforces.com/api

# ================================
# CORS Configuration
# ================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# Frontend URL (for production)
# ================================
# Set this to your deployed frontend URL in production
# CLIENT_URL=https://your-frontend-domain.com

# ================================
# Logging
# ================================
LOG_LEVEL=debug

# ================================
# Email Configuration (Resend)
# ================================
# Required for user registration and email verification.
# Resend uses HTTPS API (port 443), compatible with Render Free tier.
# Get your API key at https://resend.com
RESEND_API_KEY=
# Sender address — must be a verified sender in your Resend account.
# For initial testing, use: onboarding@resend.dev
EMAIL_FROM=CodeContest Analytics <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173

# ================================
# Legacy SMTP (no longer used for email delivery)
# ================================
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS are no longer required.
# Email is now sent via Resend HTTPS API.